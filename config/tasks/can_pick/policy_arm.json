  "recipe": "revo2_rb3_online_ik_demo2_v1",
  "env_spacing_m": 2.5,
  "domain_randomization": {
    "hand_gain_joint_pattern": "right_.*",
    "hand_material_body_pattern": "right_.*"
  },
  "training": {
    "iterations": 2000
  },
  "arm_training": {
    "enabled": true,
    "arm_config": "config/tasks/can_pick/ik_demo2.json",
    "ik_iterations": 12,
    "reset_ik_iterations": 40,
    "compile_fk": true,
    "failure_grace_steps": 4,
    "reward": {
      "ik_weight": 1.0,
      "ik_position_std_m": 0.01,
      "ik_rotation_std_rad": 0.1,
      "tracking_weight": 1.0,
      "tracking_position_std_m": 0.02,
      "tracking_rotation_std_rad": 0.2,
      "ik_failure_weight": 8.0,
      "singularity_weight": 1.0,
      "limit_weight": 0.2
    },
    "basis": "Actual fixed-base RB3+Revo2 physics. Residual action remains wrist translation/rotation and six independent fingers. Direct bounded IK at every control tick; no virtual floating response. Strict candidate errors plus actual tracking enter reward."
  }
