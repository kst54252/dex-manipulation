    "basis": "2000 arm-training iterations; full world gravity at iteration 1500, 500 iterations at 9.81. Hand gravity disabled; physical arm and object follow world gravity."
  },
  "augmentation": {
    "basis": "One fixed XY translation per episode; same 5 cm ranges as the floating policy. Actual arm q/qdot remain in observations; reset poses use strict IK with rejection sampling."
  },
  "ppo": {
    "learning_rate": 0.0001,
    "initial_std": 0.15
