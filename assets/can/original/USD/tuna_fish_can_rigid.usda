#usda 1.0
(
    defaultPrim = "TunaCan"
    metersPerUnit = 1
    upAxis = "Z"
)

# Physics wrapper around the unmodified YCB visual asset.  IsaacLab's
# RigidObject requires one rigid-body root and at least one collision shape.
def Xform "TunaCan" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    prepend references = @../007_tuna_fish_can/textured_simple.usd@
)
{
    float physics:mass = 0.15

    # The visual mesh stays render-only.  A simple cylinder derived from the
    # OBJ bounds is substantially more stable for contact simulation.
    def Cylinder "PhysicsCollision" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        uniform token axis = "Z"
        double height = 0.033511
        double radius = 0.042973
        token visibility = "invisible"
        double3 xformOp:translate = (0, 0, -0.0041195)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
